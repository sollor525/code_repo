# Makefile for VPP Integration Example Demo

# 基本设置
CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -g -O2
TARGET = vpp_integration_example
SRC = vpp_integration_example.c

# Rust库路径（相对于项目根目录）
RUST_LIB_DIR = ../../target/release
RUST_LIB_NAME = libtls_ja4.so

# 默认目标
all: build-rust-lib $(TARGET)

# 构建Rust库
build-rust-lib:
	@echo "构建Rust JA4库..."
	cd ../../ && cargo build --release
	@echo "Rust库构建完成"

# 编译C程序
$(TARGET): $(SRC) $(RUST_LIB_DIR)/$(RUST_LIB_NAME)
	@echo "编译VPP集成示例程序..."
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC) -L$(RUST_LIB_DIR) -ltls_ja4 -Wl,-rpath,$(PWD)/$(RUST_LIB_DIR) -ldl -lpthread
	@echo "编译完成"

# 运行程序
run: $(TARGET)
	@echo "运行VPP集成示例..."
	./$(TARGET)

# 清理生成的文件
clean:
	rm -f $(TARGET) *.o

# 帮助信息
help:
	@echo "VPP集成示例 Makefile"
	@echo "==================="

# 声明伪目标
.PHONY: all build-rust-lib run clean help